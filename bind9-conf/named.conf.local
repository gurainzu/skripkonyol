//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

zone "domain" {
        type master;
        file "/etc/bind/dbfile";
};

zone "DOMAIN" {
        type master;
        file "/etc/bind/DBFILE";
};

zone "firstblock.in-addr.arpa" {
        type master;
        file "/etc/bind/dbfilereverse";
};
